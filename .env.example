# ==============================================================================
# SIGMA - Modelo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env antes de executar o ambiente:
# cp .env.example .env
# Preencha todas as seis credenciais abaixo, inclusive as de monitoring.
# O Compose avalia as variáveis antes de filtrar os perfis. Não há senhas padrão.
# Para uma instalação nova, gere uma senha diferente por serviço usando:
# python -c "import secrets; print(secrets.token_hex(32))"
# Em instalações existentes, use as credenciais persistidas; mudar este arquivo
# não rotaciona senhas já gravadas no banco/Grafana. Não versione o .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS PRINCIPAL (Core SIGMA - PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=sigmadb

# ------------------------------------------------------------------------------
# 2. AUTOMAÇÃO E RELATÓRIOS (n8n)
# ------------------------------------------------------------------------------
# IP de bind para a interface web do n8n (padrão: 127.0.0.1 por segurança / VPN)
# Para acesso remoto, use um IP específico de gerência/VPN e firewall restritivo.
# Não use 0.0.0.0 ou ::. A configuração não implanta a VPN nem o firewall.
N8N_BIND_IP=127.0.0.1
# A versão instalada usa conta owner criada na primeira abertura do painel.
# N8N_USER/N8N_PASS e N8N_BASIC_AUTH_* não são suportadas; não as configure.
# Em uma instalação existente, mantenha a conta owner e o volume atuais.

# ------------------------------------------------------------------------------
# 3. PERFIL DE OBSERVABILIDADE (Opcional - Zabbix & Grafana)
# Ativado via: docker compose --profile monitoring up -d
# ------------------------------------------------------------------------------
ZABBIX_DB_USER=
ZABBIX_DB_PASS=
# Porta 10051 restrita ao host por padrão; não há coletor externo configurado.
ZABBIX_BIND_IP=127.0.0.1
# IP de bind do painel Grafana
GRAFANA_BIND_IP=127.0.0.1
# Obrigatórias; usadas para criar a conta inicial em uma instalação nova.
# Não alteram a senha de uma conta já persistida no volume do Grafana.
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. INTEGRAÇÃO COM IA (LLM - Diagnóstico assistido)
# ------------------------------------------------------------------------------
# Obrigatórias para iniciar a API. Use sua chave somente no .env ou no ambiente.
OPENROUTER_API_KEY=
# Informe um identificador de modelo disponível na sua conta OpenRouter.
SIGMA_LLM_MODEL=
# Origens exatas do painel, separadas por vírgulas, sem barra final ou curinga.
# Origem não autorizada é recusada; preflight GET/POST com Content-Type/Authorization.
# CORS não compartilha credenciais/cookies e não substitui autenticação da API.
# Em homologação/produção, substitua pelas origens HTTPS do respectivo painel.
SIGMA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Reservada para uma integração futura; não substitui OPENROUTER_API_KEY.
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 5. SEGURANÇA E AUTENTICAÇÃO DE ORIGENS (RNF07 e Auditoria)
# Chaves exclusivas para envio de alertas e integridade
# ------------------------------------------------------------------------------
SIGMA_PROBE_API_KEY=
SIGMA_PFSENSE_API_KEY=
SIGMA_AUDIT_KEY=
# Obrigatória: gere pelo menos 32 bytes aleatórios. Também é carregada pelo .env.
SIGMA_JWT_SECRET=
SIGMA_JWT_EXPIRATION_SECONDS=3600
# Inteiros positivos; limites: 100 tentativas e 86400 segundos de bloqueio.
SIGMA_MAX_LOGIN_ATTEMPTS=5
SIGMA_LOCKOUT_DURATION_SECONDS=900
# PostgreSQL migrado: postgresql+psycopg://usuario:senha@host:5432/sigmadb
# Executar alembic upgrade head antes da API; bootstrap por scripts.manage_identity.
# Se informado, tem precedência e falha sem recorrer a arquivo/memória.
SIGMA_DATABASE_URL=
# Dias de dados brutos mantidos pelo comando explícito scripts.retain_measurements.
# Agregados por minuto/hora permanecem; manutenção não é iniciada automaticamente.
SIGMA_MEASUREMENT_RETENTION_DAYS=30
# Alternativa legada de laboratório: arquivo de hashes criado por create_demo_users.py.
# Neste modo somente, usuários e sessões ficam em memória e reinício encerra sessões.
SIGMA_USERS_FILE=
# Lista local opcional, separada por vírgulas; não versione nomes reais.
SIGMA_PII_NAMES=

# Coleta contínua opt-in; requer PostgreSQL migrado. Uma liderança por banco.
SIGMA_COLLECTION_ENABLED=0
SIGMA_COLLECTION_CONCURRENCY=32
