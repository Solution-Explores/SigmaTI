[Unit]
Description=SIGMA API e coleta ativa autenticada
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=sigma
Group=sigma
WorkingDirectory=/opt/sigma
EnvironmentFile=/etc/sigma/sigma.env
Environment=PYTHON_DOTENV_DISABLED=1
ExecStart=/opt/sigma/.venv/bin/python -m uvicorn --app-dir /opt/sigma/backend main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sigma

[Install]
WantedBy=multi-user.target
